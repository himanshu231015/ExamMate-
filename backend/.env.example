# Application
PROJECT_NAME="RGPV ExamMate"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
DEBUG=True

# Security
SECRET_KEY="rgpv-exammate-super-secret-dev-key-please-change-in-production-12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite for development, PostgreSQL-ready)
DATABASE_URL="sqlite:///./data/exammate.db"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# AI / Retrieval / LLM Configuration
# LLM Provider: "mock" (offline/zero-cost default), "gemini", or "openai"
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Vector & Semantic Retrieval Provider: "bm25_semantic" or "sentence_transformers"
EMBEDDING_PROVIDER="bm25_semantic"

# Logging
LOG_LEVEL="INFO"
